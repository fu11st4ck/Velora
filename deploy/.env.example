# Copy to .env (same directory) and fill in. Never commit .env.
# ./generate-secrets.sh prints ready-made values for the passwords and the JWT keys.

# The address the app talks to. Its DNS A record must point at this server.
DOMAIN=api.example.com

# Database passwords (letters and digits only, so they are safe inside a connection URL).
POSTGRES_SUPERUSER_PASSWORD=
VELORA_OWNER_PASSWORD=
VELORA_APP_PASSWORD=

# Ed25519 key pair that signs sign-in tokens, each on one line with \n for line breaks.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=prod-1

# Outgoing email: invitations and password resets. Required — the API will not start without it.
# Example: smtps://USERNAME:PASSWORD@smtp.provider.com:465
MAIL_SMTP_URL=
MAIL_FROM=Velora <no-reply@example.com>

LOG_LEVEL=info

# Optional: copy each nightly backup off this server with rclone (see README.md), e.g. r2:velora-backups
BACKUP_RCLONE_REMOTE=
# Days of backups kept on this server.
BACKUP_KEEP_DAYS=14
