# Local development values only. Never commit a real .env.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# Application role: no DDL, subject to row-level security.
DATABASE_URL=postgresql://velora_app:velora_app_dev@localhost:5432/velora_dev
# Owner role: used only by migrations and the seed.
DATABASE_MIGRATION_URL=postgresql://velora_owner:velora_owner_dev@localhost:5432/velora_dev
# Leave the JWT keys empty in development: an ephemeral key pair is generated at start-up.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
MAIL_SMTP_URL=
MAIL_FROM=Velora <no-reply@example.com>
MOBILE_DEEP_LINK_BASE=velora://
LOG_LEVEL=info
SEED_DEMO=false
SEED_PASSWORD=
