{
  "name": "velora-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\" \"smoke/**/*.ts\"",
    "e2e": "playwright test --trace off",
    "api:types": "npx -y openapi-typescript@7.13.0 ../backend/openapi/openapi.yaml -o src/app/core/api/schema.d.ts",
    "api:check": "npx -y openapi-typescript@7.13.0 ../backend/openapi/openapi.yaml -o .angular/schema.check.d.ts && diff -q src/app/core/api/schema.d.ts .angular/schema.check.d.ts",
    "smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fontsource/inter": "5.3.0",
    "@fontsource/material-symbols-rounded": "5.3.9",
    "@fontsource/playfair-display": "5.3.0",
    "@ngrx/signals": "22.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
